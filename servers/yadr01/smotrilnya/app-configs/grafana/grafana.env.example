# Шаблон переменных окружения Grafana. Рабочий файл — /opt/appdata/config/grafana/grafana.env,
# он gitignored (*.env) и создаётся на ВМ руками; сюда не попадают реальные секреты.
#
# Проверка после старта: curl -u "$GF_SECURITY_ADMIN_USER:$GF_SECURITY_ADMIN_PASSWORD" \
#   http://127.0.0.1:10000/api/org  → 200

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<ЗАПОЛНИТЬ>

# База — локальная sqlite в /var/lib/grafana (путь задан в образе, тома и пароля не нужно).

GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# Внешний адрес, когда появится домен в Caddy (сейчас доступа снаружи нет):
# GF_SERVER_ROOT_URL=https://grafana.smotrilnya.yadr01.internal

# SSO через Authentik — пока НЕ настроен: сначала регистрация приложения в Authentik,
# потом GF_AUTH_GENERIC_OAUTH_* (client_id/client_secret/scopes) здесь же.
