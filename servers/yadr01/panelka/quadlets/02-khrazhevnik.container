[Unit]
Description=Khrazhevnik — кеш-прокси и зеркало linux-репозиториев
After=network-online.target

[Container]
Image=git.yadr00.internal/alexrus1234/khrazhevnik:latest
AutoUpdate=registry

# Публичный порт (пакеты, /healthz) и админка (UI/API/metrics — в LAN, защита: JWT + rate-limit)
PublishPort=10002:29202
PublishPort=10003:30202

# Мапим пользователя ВМ в nobody(65534:65534) внутри контейнера (образ из scratch, USER 65534):
# спул-каталог на хосте остаётся владельцем app-runner
UserNS=keep-id:uid=65534,gid=65534

# Объекты — в RustFS (S3), каталог — в PostgreSQL (оба по P2P-линку 172.21.6.x).
# Writable нужен только спулу S3-драйвера (объекты в бакете)
ReadOnly=true
Volume=/opt/appdata/db/khrazhevnik/spool:/var/lib/khrazhevnik/spool

# Секреты (JWT, ключи S3, DSN) — rootless env-файл (вне git, как у nora)
EnvironmentFile=/opt/appdata/config/khrazhevnik/khrazhevnik.env

# Весь апстрим (fetch кеш-прокси + mirror sync) — через socks5 шлюза, без авторизации.
# Прокси задаётся env, не TOML: outboundHTTPClient читает http.ProxyFromEnvironment;
# ALL_PROXY не читается — поэтому оба варианта сразу. Схема обязательна (иначе CONNECT на SOCKS-порт).
# NO_PROXY: loopback + RustFS/PostgreSQL по P2P-линку (minio-go тоже читает эти переменные)
Environment=HTTP_PROXY=socks5h://172.20.0.1:1080
Environment=HTTPS_PROXY=socks5h://172.20.0.1:1080
Environment=NO_PROXY=localhost,127.0.0.1,::1,172.21.6.249

# Pomen (домен khrazhevnik.panelka.yadr01.internal)
# port-10002 обязателен: у контейнера два PublishPort, без label Pomen взял бы первый попавшийся
Label=port-10002
Label=proto-http
Label=KHRZ
Label=10002

# Graceful shutdown каскад: HTTP 5с + фоновые задачи 30с
StopTimeout=40

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
