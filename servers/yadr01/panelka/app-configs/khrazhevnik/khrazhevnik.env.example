# RustFS (S3) и PostgreSQL — по P2P-линку vmbr1 (172.21.6.x)
KHRZ_STORAGE__DRIVER=s3
KHRZ_STORAGE__S3__ENDPOINT=http://172.21.6.249:9000
KHRZ_STORAGE__S3__REGION=us-east-1
KHRZ_STORAGE__S3__BUCKET=khrazhevnik
KHRZ_STORAGE__S3__PATH_STYLE=true
KHRZ_STORAGE__S3__ACCESS_KEY_ID=
KHRZ_STORAGE__S3__SECRET_ACCESS_KEY=

KHRZ_DATABASE__DRIVER=postgres
KHRZ_DATABASE__DSN=postgres://khrazhevnik:ПАРОЛЬ@172.21.6.249:5432/khrazhevnik

# Обязателен, >=32 байт: openssl rand -hex 32
KHRZ_AUTH__JWT_SECRET=
