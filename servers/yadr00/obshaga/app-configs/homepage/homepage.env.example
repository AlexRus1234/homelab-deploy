# Секреты API-токенов Proxmox. Подставляются в proxmox.yaml через {{HOMEPAGE_VAR_*}}.
# Скопировать в /opt/appdata/config/homepage/homepage.env и заполнить — боевой .env в git НЕ коммитить!

# Секрет токена PVE yadr00 (группа api-ro-users, readonly)
HOMEPAGE_VAR_PROXMOX_SECRET_YADR00=

# Секрет токена PVE yadr01 (группа api-ro-users, readonly)
HOMEPAGE_VAR_PROXMOX_SECRET_YADR01=

# Токен Forgejo для виджета (Settings → Applications → Generate new token;
# scopes: repository, issue, notifications)
HOMEPAGE_VAR_FORGEJO_TOKEN=

# Секрет токена PBS (юзер homepage@pam + токен homepage, роль Audit И юзеру, И токену)
HOMEPAGE_VAR_PBS_SECRET=

# Логин/пароль веб-интерфейса AdGuard Home
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# API-токен Хражевника (khz_..., scope admin) — статистика кеша
HOMEPAGE_VAR_KHRZ_TOKEN=
