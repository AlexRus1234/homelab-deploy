# Секреты API-токенов Proxmox. Подставляются в proxmox.yaml через {{HOMEPAGE_VAR_*}}.
# Скопировать в /opt/appdata/config/homepage/homepage.env и заполнить — боевой .env в git НЕ коммитить!

# Секрет токена PVE yadr00 (группа api-ro-users, readonly)
HOMEPAGE_VAR_PROXMOX_SECRET_YADR00=

# Секрет токена PVE yadr01 (группа api-ro-users, readonly)
HOMEPAGE_VAR_PROXMOX_SECRET_YADR01=
