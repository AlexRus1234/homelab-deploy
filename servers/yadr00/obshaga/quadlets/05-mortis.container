[Unit]
Description=Mortis (Memos API Gateway 0.21.0 -> latest)
After=04-memos.service

[Container]
Image=git.yadr00.internal/build/mortis:latest
AutoUpdate=registry

Pod=memos.pod

Exec=-addr=0.0.0.0 -port=5231 -grpc-addr=localhost:5230

Label=Mortis
Label=10005
Label=proto-http

[Install]
WantedBy=default.target
