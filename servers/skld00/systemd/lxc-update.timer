# Таймер ночного окна: прогон встаёт в 02:00–03:00 по ЛОКАЛЬНОМУ времени узла
# (на skld00 это MSK), со случайным сдвигом внутри часа — «ровно в две ночи» не бывает,
# и у нескольких узлов парка окна не совпадают.
[Unit]
Description=skld00: окно ночного обновления (02:00–03:00, случайный сдвиг)

[Timer]
OnCalendar=*-*-* 02:00:00
# Случайный сдвиг внутри окна: 3600 с = весь час после 02:00.
RandomizedDelaySec=3600
AccuracySec=1min
# Если узел был выключен в окно — прогон случится после включения, а не потеряется.
Persistent=true
Unit=lxc-update.service

[Install]
WantedBy=timers.target
